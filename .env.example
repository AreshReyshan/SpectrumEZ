# ==========================================
# SpectrumEz Configuration
# ==========================================

# Your Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram Chat ID (Numeric ID, automatically detected when you send /start)
TELEGRAM_CHAT_ID=

# UM Spectrum Base URL
SPECTRUM_BASE_URL=https://spectrum.um.edu.my

# Monitoring Intervals (in seconds)
ATTENDANCE_CHECK_INTERVAL=180     # Check for open class attendance every 3 minutes
ANNOUNCEMENTS_CHECK_INTERVAL=900  # Check for new forum announcements every 15 minutes
DEADLINES_CHECK_INTERVAL=1800     # Check for assignment deadlines every 30 minutes

# Local Web Dashboard Settings
DASHBOARD_PORT=8080
DASHBOARD_HOST=127.0.0.1
